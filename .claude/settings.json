{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rmdir:*)",
      "Bash(git reset:*)",
      "Read(.env.*)",
      "Read(env.yaml)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*key*)",
      "Write(.env*)",
      "Write(**/secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(psql:*)"
    ]
  },
  "plansDirectory": "./.claude/_docs/plans",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/on-write-edit-rustfmt-clippy.sh",
            "timeout": 120,
            "statusMessage": "Running rustfmt + clippy..."
          }
        ]
      }
    ]
  }
}
